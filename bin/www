#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('nishat-college:server');
var http = require('http');
var mongoose = require('mongoose');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

app.locals.databaseReady.then(() => {
  server.listen(port);
}).catch((error) => {
  console.error("Unable to connect to MongoDB:", error.message);
  process.exit(1);
});
server.on('error', onError);
server.on('listening', onListening);

var shuttingDown = false;
function shutdown() {
  if (shuttingDown) return;
  shuttingDown = true;
  var forceExit = setTimeout(function () { process.exit(1); }, 10000);
  forceExit.unref();
  server.close(async function (error) {
    try {
      await app.locals.sessionStore.close();
      await mongoose.disconnect();
      clearTimeout(forceExit);
      process.exit(error ? 1 : 0);
    } catch (closeError) {
      console.error('Unable to close database connections cleanly:', closeError.message);
      process.exit(1);
    }
  });
}
process.once('SIGTERM', shutdown);
process.once('SIGINT', shutdown);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
