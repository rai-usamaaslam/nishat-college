MONGO_URI=mongodb://127.0.0.1:27017/nishat_college
SESSION_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Nishat Institute of Medical Science and Technology <noreply@example.com>
# Production must use a public HTTPS APP_BASE_URL, remote MONGO_URI,
# unique SESSION_SECRET (32+ characters), and real SMTP credentials.
