<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Learn about Nishat Institute of Medical Science and Technology.">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/public-pages.css">
    <link rel="stylesheet" href="/stylesheets/public-theme.css">
  </head>
  <body>
    <%- include("_site-header", { active: "about" }) %>
    <main>
      <section class="page-hero about-page-hero">
        <span class="eyebrow">ABOUT THE COLLEGE</span>
        <h1>Medical education with purpose.</h1>
        <p>Nishat Institute of Medical Science and Technology helps students prepare for meaningful work in healthcare.</p>
      </section>
      <section class="about-content about-route-content">
        <figure class="about-route-photo">
          <img src="/images/director/IMG-20260923-WA0020.jpg" alt="Nishat Akhtar, Director of Nishat Institute of Medical Science and Technology" loading="lazy" decoding="async">
          <figcaption>Director · Nishat Akhtar</figcaption>
        </figure>
        <div class="about-route-copy">
          <article>
            <span class="eyebrow">OUR Director Message</span>
            <h2>Build knowledge. Grow with purpose.</h2>
            <p>We bring together academic programs and an admissions process to help prospective students understand their options and plan their next step.</p>
            <p>Each program page explains its course content, duration, eligibility, and fee. Applicants can submit their details online for review by the admissions team.</p>
            <a class="button-primary" href="/courses">Explore our programs →</a>
          </article>
          <aside class="about-note">
            <span class="eyebrow">FOR PROSPECTIVE STUDENTS</span>
            <h2>Find the details you need.</h2>
            <p>Compare available programs, review requirements, and contact the college if you have a question.</p>
            <a class="text-link" href="/contact">Contact us →</a>
          </aside>
        </div>
      </section>
    </main>
    <%- include("_site-footer") %>
  </body>
</html>
