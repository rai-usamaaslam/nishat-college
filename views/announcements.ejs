<!doctype html><html lang="en-PK"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Admissions news, academic notices, and college updates from Nishat Institute of Medical Science and Technology in Chiniot, Punjab."><meta property="og:type" content="website"><meta property="og:title" content="Announcements | Nishat Institute, Chiniot"><meta property="og:description" content="College updates and announcements from Chiniot, Punjab, Pakistan."><meta property="og:locale" content="en_PK"><link rel="canonical" href="<%= siteOrigin %>/announcements"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:""}) %><main><section class="page-hero"><span class="eyebrow">COLLEGE UPDATES</span><h1>Announcements</h1><p>News and updates published by Nishat Institute of Medical Science and Technology.</p></section><section class="announcement-page"><div class="announcement-list"><% if (!announcements.length) { %><p class="empty-public">No announcements at this time.</p><% } %><% announcements.forEach(item => { %><article><span><%= new Date(item.createdAt).toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}) %></span><div><h2><%= item.title %></h2><p><%= item.description %></p></div></article><% }) %></div></section></main><%- include("_site-footer") %></body></html>
