<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:""}) %><main><section class="page-hero"><span class="eyebrow">COLLEGE UPDATES</span><h1>Announcements</h1><p>News and updates published by Nishat Institute of Medical Science and Technology.</p></section><section class="announcement-page"><div class="announcement-list"><% if (!announcements.length) { %><p class="empty-public">No announcements at this time.</p><% } %><% announcements.forEach(item => { %><article><span><%= new Date(item.createdAt).toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}) %></span><div><h2><%= item.title %></h2><p><%= item.description %></p></div></article><% }) %></div></section></main><%- include("_site-footer") %></body></html>
