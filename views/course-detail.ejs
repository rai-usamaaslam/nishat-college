<!doctype html><html lang="en-PK"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= course.shortDescription %> Study at Nishat Institute of Medical Science and Technology in Chiniot, Punjab, Pakistan."><meta property="og:type" content="website"><meta property="og:title" content="<%= course.title %> | Nishat Institute, Chiniot"><meta property="og:description" content="<%= course.shortDescription %>"><meta property="og:locale" content="en_PK"><link rel="canonical" href="<%= siteOrigin %>/courses/<%= course._id %>"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:"programs"}) %><main><section class="detail-hero"><% if (course.image) { %><img class="detail-hero-image" src="<%= course.image %>" alt="" aria-hidden="true" fetchpriority="high"><% } %><a class="crumb" href="/courses">← All programs</a><span class="eyebrow">ACADEMIC PROGRAM</span><h1><%= course.title %></h1><p><%= course.shortDescription %></p><a class="button-primary" href="/apply/<%= course._id %>">Apply for this course <span>→</span></a></section><section class="course-detail-layout"><article class="course-description"><span class="eyebrow">ABOUT THE PROGRAM</span><h2>Course overview</h2><div class="prose"><%= course.description %></div></article><aside class="course-facts"><h2>Course details</h2><dl><dt>Duration</dt><dd><%= course.duration %></dd><dt>Eligibility</dt><dd><%= course.eligibility %></dd><dt>Fee</dt><dd>PKR <%= Number(course.fee).toLocaleString() %></dd></dl><a class="button-primary full-width" href="/apply/<%= course._id %>">Start application →</a></aside></section></main><%- include("_site-footer") %></body></html>
