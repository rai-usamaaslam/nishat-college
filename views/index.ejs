<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Discover medical and allied health education at Nishat Institute of Medical Science and Technology in Chiniot, Punjab, Pakistan.">
    <meta name="geo.region" content="PK-PB">
    <meta name="geo.placename" content="Chiniot, Punjab, Pakistan">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Nishat Institute of Medical Science and Technology | Chiniot">
    <meta property="og:description" content="Medical and allied health education in Chiniot, Punjab, Pakistan.">
    <meta property="og:locale" content="en_PK">
    <link rel="canonical" href="<%= siteOrigin %>/">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script type="application/ld+json">
      <%- JSON.stringify({"@context":"https://schema.org","@type":"EducationalOrganization","name":"Nishat Institute of Medical Science and Technology","address":{"@type":"PostalAddress","streetAddress":siteSettings.address,"addressLocality":"Chiniot","addressRegion":"Punjab","addressCountry":"PK"},"telephone":siteSettings.phone,"email":siteSettings.email}).replace(/</g, "\\u003c") %>
    </script>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/public-pages.css">
    <link rel="stylesheet" href="/stylesheets/public-home.css">
    <link rel="stylesheet" href="/stylesheets/public-theme.css">
  </head>
  <body>
    <%- include("_site-header", { active: "home" }) %>

    <main>
      <!-- Hero -->
      <section class="hero" id="home">
        <div class="hero-inner">
          <span class="eyebrow">NISHAT INSTITUTE OF MEDICAL SCIENCE AND TECHNOLOGY</span>
          <h1>Build your future<br>in healthcare.</h1>
          <p>Explore our academic programs, understand your options, and take your next step with confidence.</p>
          <a class="button-primary" href="/courses">Explore our programs <span>→</span></a>
          <a class="hero-secondary" href="/about">Get to know us</a>
        </div>
      </section>

      <!-- About the institute -->
      <section class="home-about">
        <div class="about-lead">
          <div class="about-copy">
            <span class="eyebrow">ABOUT THE INSTITUTE</span>
            <h2>A Trusted Institution for Tomorrow's Healthcare Leaders</h2>
            <p>Nishat Institute of Medical Science and Technology brings together experienced faculty, modern learning resources, and a structured academic environment to prepare students for successful careers in healthcare. We focus on both theoretical depth and practical, career-ready skills.</p>
          </div>
          <figure class="about-photo">
            <img src="/images/optimized/aboutpic.webp" alt="Healthcare professionals working in a modern clinical environment" width="900" height="600" loading="lazy" decoding="async">
          </figure>
        </div>
        <div class="about-actions">
          <a class="button-primary" href="/about">Explore more <span>→</span></a>
        </div>
      </section>

      <!-- Featured programs -->
      <section class="home-programs">
        <div class="section-heading">
          <div>
            <span class="eyebrow">ACADEMIC PROGRAMS</span>
            <h2>Find a program that fits your goals.</h2>
          </div>
          <p>Compare the essentials, then open a course page for the full description and application details.</p>
        </div>
        <div class="course-grid">
          <% if (!courses.length) { %>
            <p class="empty-public">Program information will be published here soon.</p>
          <% } %>
          <% courses.slice(0, 3).forEach((course) => { %>
            <article class="course-card">
              <div class="course-copy">
                <span class="eyebrow">ACADEMIC PROGRAM</span>
                <h3><%= course.title %></h3>
                <p><%= course.shortDescription %></p>
                <div class="course-meta">
                  <span><b>Duration</b><%= course.duration %></span>
                  <span><b>Fee</b>PKR <%= Number(course.fee).toLocaleString() %></span>
                </div>
                <a class="text-link" href="/courses/<%= course._id %>">View course details →</a>
              </div>
            </article>
          <% }) %>
        </div>
        <div class="section-actions">
          <a class="button-primary" href="/courses">View all programs <span>→</span></a>
        </div>
      </section>

      <!-- Why choose us -->
      <section class="why-section">
        <div class="why-intro">
          <span class="eyebrow">WHY CHOOSE US</span>
          <h2>A clear path from exploration to application.</h2>
          <p>Build your future in a supportive academic environment that brings together experienced faculty, focused learning, and practical preparation. We make it easier to understand your options, compare course requirements, and take your next step toward a healthcare career.</p>
        </div>
        <div class="why-grid">
          <article>
            <div><h3>Experienced Faculty</h3><p>Learn from dedicated educators and experienced professionals who are committed to providing students with quality academic guidance and practical knowledge.</p></div>
          </article>
          <article>
            <div><h3>Modern Learning Environment</h3><p>Study in a professional and supportive environment designed to encourage learning, collaboration, discipline, and the development of essential academic skills.</p></div>
          </article>
          <article>
            <div><h3>Student-Focused Education</h3><p>We focus on the overall development of our students through structured education, professional values, confidence, communication, and a strong sense of responsibility.</p></div>
          </article>
        </div>
        <div class="section-actions">
          <a class="button-light" href="/contact">Talk to our team <span>→</span></a>
        </div>
      </section>

      <!-- Application callout -->
      <section class="home-apply-section">
        <div class="apply-callout">
          <div>
            <span class="eyebrow">START YOUR JOURNEY</span>
            <h2>Ready to take the next step?</h2>
            <p>Choose a program to review its details and begin your application.</p>
          </div>
          <a class="button-primary" href="/courses">Apply Now <span>→</span></a>
        </div>
      </section>

      <!-- Latest announcement -->
      <% if (announcements.length) { %>
        <section class="home-update">
          <div>
            <span class="eyebrow">LATEST UPDATE</span>
            <h2><%= announcements[0].title %></h2>
            <p><%= announcements[0].description %></p>
          </div>
          <a class="button-outline" href="/announcements">All announcements <span>→</span></a>
        </section>
      <% } %>
    </main>

    <%- include("_site-footer") %>
  </body>
</html>
