<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Browse courses at Nishat Institute of Medical Science and Technology."><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:"programs"}) %><main><section class="page-hero"><span class="eyebrow">ACADEMIC PROGRAMS</span><h1>Our Programs</h1><p>Review course information and requirements, then open a program to see full details.</p></section><section class="programs-page"><div class="course-grid">
<% if (!courses.length) { %><p class="empty-public">Program information will be published here soon.</p><% } %><% courses.forEach(course => { %><article class="course-card"><div class="course-image"><% if (course.image) { %><img src="<%= course.image %>" alt="<%= course.title %>" loading="lazy"><% } else { %><span>NMC</span><% } %></div><div class="course-copy"><span class="eyebrow">ACADEMIC PROGRAM</span><h3><%= course.title %></h3><p><%= course.shortDescription %></p><div class="course-meta"><span><b>Duration</b><%= course.duration %></span><span><b>Fee</b>PKR <%= Number(course.fee).toLocaleString() %></span></div><a class="text-link" href="/courses/<%= course._id %>">Complete course details →</a></div></article><% }) %>
</div></section></main><%- include("_site-footer") %></body></html>
