<!doctype html>
<html lang="en-PK">
  <head><meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Explore medical and allied health programs at Nishat Institute of Medical Science and Technology in Chiniot, Punjab, Pakistan.">
    <meta property="og:type" content="website"><meta property="og:title" content="Medical &amp; Allied Health Programs | Chiniot"><meta property="og:description" content="Explore healthcare education programs at Nishat Institute in Chiniot."><meta property="og:locale" content="en_PK"><link rel="canonical" href="<%= siteOrigin %>/courses"><link rel="icon" type="image/svg+xml" href="/favicon.svg"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head>
    <body>
<%- include("_site-header", {active:"programs"}) %><main>
  <section class="page-hero programs-hero"><span class="eyebrow programs-eyebrow">
  <img src="/images/logo/IMG-20260923-WA0018(1).jpg" alt="" aria-hidden="true">ACADEMIC PROGRAMS
</span>
  <h1>Our Programs</h1>
  <p>Review course information and requirements, then open a program to see full details.</p></section>
  <section class="programs-page"><div class="course-grid">
<% if (!courses.length) { %><p class="empty-public">Program information will be published here soon.</p><% } %><% courses.forEach(course => { %><article class="course-card"><% if (course.image) { %><img class="course-image" src="<%= course.image %>" alt="<%= course.title %> program" loading="lazy"><% } %><div class="course-copy"><span class="eyebrow">ACADEMIC PROGRAM</span><h3><%= course.title %></h3><p><%= course.shortDescription %></p><div class="course-meta"><span><b>Duration</b><%= course.duration %></span><span><b>Fee</b>PKR <%= Number(course.fee).toLocaleString() %></span></div><a class="text-link" href="/courses/<%= course._id %>">Complete course details →</a></div></article><% }) %>
</div></section></main><%- include("_site-footer") %></body></html>
