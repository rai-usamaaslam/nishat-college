<!doctype html>
<html lang="en-PK">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Contact Nishat Institute of Medical Science and Technology in Chiniot, Punjab for admissions, program information, and general enquiries.">
    <meta name="geo.region" content="PK-PB">
    <meta name="geo.placename" content="Chiniot, Punjab, Pakistan">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Contact Nishat Institute | Chiniot">
    <meta property="og:description" content="Get in touch with Nishat Institute of Medical Science and Technology in Chiniot, Punjab.">
    <meta property="og:locale" content="en_PK">
    <link rel="canonical" href="<%= siteOrigin %>/contact">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script type="application/ld+json">
      <%- JSON.stringify({"@context":"https://schema.org","@type":"EducationalOrganization","name":"Nishat Institute of Medical Science and Technology","address":{"@type":"PostalAddress","streetAddress":siteSettings.address,"addressLocality":"Chiniot","addressRegion":"Punjab","addressCountry":"PK"},"telephone":siteSettings.phone,"email":siteSettings.email}).replace(/</g, "\\u003c") %>
    </script>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/public-pages.css">
    <link rel="stylesheet" href="/stylesheets/public-theme.css">
  </head>
  <body>
    <%- include("_site-header", {active:"contact"}) %>
    <main>
      <section class="page-hero contact-hero">
        <span class="eyebrow">GET IN TOUCH</span>
        <h1>Contact College Team</h1>
        <p>We’re ready to help with admissions, programs, and general enquiries. Send us a message or reach us directly.</p>
      </section>

      <section class="contact-layout contact-page-layout" aria-label="Contact information and enquiry form">
        <div class="contact-intro">
          <span class="eyebrow">WE’RE HERE TO HELP</span>
          <h2>Let’s start a conversation.</h2>
          <p>Tell us what you’d like to know and our team will direct your enquiry to the right place. For program details, you can also explore our course listings.</p>
          <a class="text-link" href="/courses">Explore our programs <span aria-hidden="true">→</span></a>

          <div class="contact-details">
            <a class="contact-detail" href="tel:<%= siteSettings.phone.replace(/[^\d+]/g, '') %>">
              <span class="contact-detail-icon" aria-hidden="true">☎</span>
              <span><small>CALL US</small><strong><%= siteSettings.phone %></strong></span>
            </a>
            <a class="contact-detail" href="mailto:<%= siteSettings.email %>">
              <span class="contact-detail-icon" aria-hidden="true">@</span>
              <span><small>EMAIL US</small><strong><%= siteSettings.email %></strong></span>
            </a>
            <div class="contact-detail">
              <span class="contact-detail-icon" aria-hidden="true">⌖</span>
              <span><small>VISIT US</small><strong><%= siteSettings.address %></strong></span>
            </div>
          </div>
        </div>

        <div class="contact-card">
          <div class="contact-form-heading">
            <h2>Send us a message</h2>
            <p>Complete the form and we’ll get back to you.</p>
          </div>
          <% if (message) { %><div class="success-note" role="status"><%= message %></div><% } %>
          <% if (error) { %><div class="public-error" role="alert"><%= error %></div><% } %>
          <form class="public-form contact-form contact-form-grid" method="post" action="/contact">
            <label>Your name<input name="name" maxlength="120" autocomplete="name" required value="<%= values.name || '' %>"></label>
            <label>Email address<input name="email" type="email" maxlength="254" autocomplete="email" required value="<%= values.email || '' %>"></label>
            <label class="span-two">Subject<input name="subject" maxlength="160" required value="<%= values.subject || '' %>"></label>
            <label class="span-two">Message<textarea name="message" rows="6" maxlength="3000" required><%= values.message || '' %></textarea></label>
            <button class="button-primary span-two" type="submit">Send message <span aria-hidden="true">→</span></button>
            <p class="contact-privacy span-two">Your details will only be used to respond to your enquiry.</p>
          </form>
        </div>
      </section>

      <section class="contact-map-section" aria-labelledby="contact-map-title">
        <div class="contact-map-heading">
          <div>
            <span class="eyebrow">FIND OUR CAMPUS</span>
            <h2 id="contact-map-title">Visit us in Chiniot</h2>
            <p><%= siteSettings.address %></p>
          </div>
          <a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(siteSettings.address) %>" target="_blank" rel="noopener noreferrer">Open in Google Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-map-frame">
          <iframe title="Map showing Nishat Institute of Medical Science and Technology in Chiniot" src="https://maps.google.com/maps?q=<%= encodeURIComponent(siteSettings.address) %>&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </section>
    </main>
    <%- include("_site-footer") %>
  </body>
</html>
