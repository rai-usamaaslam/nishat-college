<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Contact Nishat Institute of Medical Science and Technology."><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:"contact"}) %><main><section class="page-hero"><span class="eyebrow">GET IN TOUCH</span><h1>Contact Nishat Institute of Medical Science and Technology</h1><p>Send a question to the college team. Include a reply email so we can get back to you.</p></section><section class="contact-layout"><div><span class="eyebrow">QUESTIONS ABOUT ADMISSIONS?</span><h2>We’re here to help.</h2><p>For program-specific information, visit the course page. For other questions, send us a message using this form.</p><a class="text-link" href="/courses">Browse programs →</a></div><div class="contact-card"><% if (message) { %><div class="success-note" role="status"><%= message %></div><% } %><% if (error) { %><div class="public-error" role="alert"><%= error %></div><% } %><form class="public-form contact-form" method="post" action="/contact"><label>Your name<input name="name" maxlength="120" required value="<%= values.name || '' %>"></label><label>Email address<input name="email" type="email" maxlength="254" required value="<%= values.email || '' %>"></label><label class="span-two">Subject<input name="subject" maxlength="160" required value="<%= values.subject || '' %>"></label><label class="span-two">Message<textarea name="message" rows="6" maxlength="3000" required><%= values.message || '' %></textarea></label><button class="button-primary span-two" type="submit">Send message →</button></form></div></section></main><%- include("_site-footer") %></body></html>
