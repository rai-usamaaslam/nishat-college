<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.css"><link rel="stylesheet" href="/stylesheets/public-pages.css"><link rel="stylesheet" href="/stylesheets/public-theme.css"></head><body>
<%- include("_site-header", {active:"programs"}) %><main class="application-main"><a class="crumb" href="/courses/<%= course._id %>">← <%= course.title %></a><span class="eyebrow">ADMISSIONS</span><h1>Apply for <%= course.title %></h1><p>Complete the form below. Our admissions office will review your application.</p><% if (error) { %><div class="public-error"><%= error %></div><% } %><form class="public-form" method="post" action="/apply/<%= course._id %>"><label>Student full name<input name="studentName" required value="<%= values.studentName || '' %>"></label><label>Father / guardian name<input name="fatherName" required value="<%= values.fatherName || '' %>"></label><label>Email<input name="email" type="email" required value="<%= values.email || '' %>"></label><label>Phone<input name="phone" type="tel" required value="<%= values.phone || '' %>"></label><label>CNIC<input name="cnic" required value="<%= values.cnic || '' %>"></label><label>Date of birth<input name="dob" type="date" required value="<%= values.dob || '' %>"></label><label>Gender<select name="gender" required><option value="">Select</option><% ["Female","Male","Other"].forEach(item => { %><option <%= values.gender === item ? "selected" : "" %>><%= item %></option><% }) %></select></label><label>Last qualification<input name="qualification" required value="<%= values.qualification || '' %>"></label><label>Marks / percentage<input name="marks" type="number" min="0" step="0.01" required value="<%= values.marks ?? '' %>"></label><label class="span-two">Address<textarea name="address" rows="3" required><%= values.address || '' %></textarea></label><button class="button-primary span-two">Submit application →</button></form></main><%- include("_site-footer") %></body></html>
