<!doctype html><html lang="en"><head><link rel="icon" type="image/svg+xml" href="/favicon.svg"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/admin-login.css"><link rel="stylesheet" href="/stylesheets/admin-pages.css"></head><body><main class="login-shell"><section class="brand-panel"><a class="brand" href="/"><img class="auth-logo" src="/images/optimized/logo.webp" alt=""><span><strong>Nishat Institute</strong><small>Medical Science and Technology</small></span></a><div class="brand-message"><span class="eyebrow">ACCOUNT RECOVERY</span><h1>Choose a new password.</h1><p>Use at least 12 characters to protect your administrator account.</p></div><span class="panel-caption">NISHAT INSTITUTE OF MEDICAL SCIENCE AND TECHNOLOGY</span></section><section class="form-panel"><div class="form-wrap"><span class="eyebrow">NEW PASSWORD</span><h2>Reset password</h2><% if (error) { %><div class="error" role="alert"><%= error %></div><% } %><% if (token) { %><form action="/admin/reset-password/<%= token %>" method="post"><label for="password">New password</label><input id="password" name="password" type="password" minlength="12" autocomplete="new-password" required><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="12" autocomplete="new-password" required><button type="submit">Set new password <span>→</span></button></form><% } %><a class="back-link" href="/admin/login">← Back to sign in</a></div></section></main></body></html>
