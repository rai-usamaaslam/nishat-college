<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title><link rel="icon" type="image/svg+xml" href="/favicon.svg"><link rel="stylesheet" href="/stylesheets/admin.css"><link rel="stylesheet" href="/stylesheets/admin-pages.css">
</head>
<body>
