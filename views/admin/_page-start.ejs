      <a class="<%= active === 'applications' ? 'current' : '' %>" href="/admin/applications">Applications</a>
      <a class="<%= active === 'announcements' ? 'current' : '' %>" href="/admin/announcements">Announcements</a>
      <a class="<%= active === 'settings' ? 'current' : '' %>" href="/admin/settings">Settings</a>
