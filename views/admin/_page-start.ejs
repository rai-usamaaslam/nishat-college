    <a class="pagebrand" href="/admin/dashboard"><img src="/images/optimized/logo.webp" alt="" class="admin-logo" width="52" height="52"><strong>Nishat Institute of Medical Science and Technology</strong></a>
    <nav aria-label="Admin navigation">
      <a class="<%= active === 'dashboard' ? 'current' : '' %>" href="/admin/dashboard">Dashboard</a>
