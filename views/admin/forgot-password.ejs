<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/admin-login.css"></head><body><main class="login-shell"><section class="brand-panel"><a class="brand" href="/"><img class="auth-logo" src="/images/logo/IMG-20260923-WA0018(1).jpg" alt=""><span><strong>Nishat Institute</strong><small>Medical Science and Technology</small></span></a><div class="brand-message"><span class="eyebrow">ACCOUNT RECOVERY</span><h1>Regain secure access.</h1><p>We’ll send a time-limited reset link to your administrator email.</p></div><span class="panel-caption">NISHAT INSTITUTE OF MEDICAL SCIENCE AND TECHNOLOGY</span></section><section class="form-panel"><div class="form-wrap"><span class="eyebrow">PASSWORD RESET</span><h2>Forgot password?</h2><p class="intro">Enter your admin account email address.</p><% if (error) { %><div class="error" role="alert"><%= error %></div><% } %><% if (message) { %><div class="success" role="status"><%= message %></div><% } %><form action="/admin/forgot-password" method="post"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required><button type="submit">Send reset link <span>→</span></button></form><a class="back-link" href="/admin/login">← Back to sign in</a></div><footer>© <%= new Date().getFullYear() %> Nishat Institute of Medical Science and Technology</footer></section></main></body></html>
