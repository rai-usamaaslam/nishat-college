<%- include("_page-start", {title, admin, active: "applications"}) %>
<div class="page-title-row"><div><span class="eyebrow">ADMISSIONS</span><h1>Applications</h1><p>Review applicant details and update admission decisions.</p></div></div>
<form class="filter-row" method="get"><label for="status-filter">Status</label><select id="status-filter" name="status"><option value="">All statuses</option><% ["Pending","Accepted","Rejected"].forEach(item => { %><option value="<%= item %>" <%= status === item ? "selected" : "" %>><%= item %></option><% }) %></select><button class="secondary-button">Filter</button></form>
<div class="table-card"><div class="table-scroll"><table><thead><tr><th>Applicant</th><th>Course</th><th>Submitted</th><th>Status</th><th>Details</th></tr></thead><tbody>
<% if (!applications.length) { %><tr><td colspan="5" class="empty-state">No applications found.</td></tr><% } %>
<% applications.forEach(application => { %><tr><td><strong><%= application.studentName %></strong><small><%= application.email %></small></td><td><%= application.course ? application.course.title : "Course unavailable" %></td><td><%= new Date(application.createdAt).toLocaleDateString("en-GB") %></td><td><span class="status-pill <%= application.status.toLowerCase() %>"><%= application.status %></span></td><td><a class="secondary-link" href="/admin/applications/<%= application._id %>">Review →</a></td></tr><% }) %>
</tbody></table></div></div>
<%- include("_page-end") %>
